# One-shot migrate-mongo runner for the Coolify stack (../docker-compose.yml).
# The Synology deploy.sh instead tars these same files into a throwaway bun container.
FROM oven/bun:1.3.11

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY migrate-mongo-config.js ./
COPY migrations ./migrations

CMD ["bun", "node_modules/migrate-mongo/bin/migrate-mongo.js", "up"]
